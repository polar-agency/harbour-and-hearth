---
import { getEntry } from 'astro:content';
const site = (await getEntry('site', 'site'))!.data;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul class="header__nav">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header { padding: var(--space-6) 0; }
  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .header__logo {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    text-decoration: none;
  }
  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    display: block;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }
  .header__nav a:hover { background: var(--color-surface); }
  .header__nav a[aria-current='page'] {
    background: var(--color-text);
    color: var(--color-bg);
  }
</style>
