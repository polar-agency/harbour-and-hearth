---
import { getEntry } from 'astro:content';
const site = (await getEntry('site', 'site'))!.data;
---
<dl class="hours">
  {site.openingHours.map((row) => (
    <div class="hours__row">
      <dt>{row.days}</dt>
      <dd>{row.hours}</dd>
    </div>
  ))}
</dl>

<style>
  .hours { margin: 0; }
  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: var(--border-width) dashed var(--color-brown-soft);
  }
  dt { font-weight: var(--weight-medium); }
  dd { margin: 0; text-align: right; color: var(--color-text-muted); }
</style>
